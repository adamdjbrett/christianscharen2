---
layout: layout.njk
title: Events
description: Calendar of events with Christian Scharen
hero: 
  title: Events
  info: Calendar
pagination:
  data: events.items
  size: 5
permalink: "/events/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
eleventyExcludeFromCollections: true
---

<section class="section-padding border-top-custom h-feed">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8">
                <span class="font-sans text-uppercase text-accent tracking-wider text-sm d-block mb-3">{{hero.info}}</span>
                <h1 class="section-heading p-name">{{hero.title}}</h1>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="border-top-custom">
                    {% for event in pagination.items %}
                    <a href="/events/{{ event.slug }}/" class="article-item h-event">
                        <div class="row align-items-center">
                            <div class="col-md-3">
                                <span class="article-meta">{{ event.date | postDate }}</span>
                            </div>
                            <div class="col-md-9">
                                <h3 class="article-title p-name">{{ event.title }}</h3>
                                <span class="article-meta">{{ event.venue }} &bull; {{ event.city }}</span>
                            </div>
                        </div>
                    </a>
                    {% endfor %}
                </div>
                <div class="editorial-pagination">
                    {% if pagination.href.previous %}
                    <a href="{{ pagination.href.previous }}" aria-label="Previous">{% icon "arrow-left" %}</a>
                    {% endif %}
                    <span class="current-page">{{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
                    {% if pagination.href.next %}
                    <a href="{{ pagination.href.next }}" aria-label="Next">{% icon "arrow-right" %}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
