<section class="section-padding border-top-custom">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        {% if date %}<span class="font-sans text-uppercase text-accent tracking-wider text-sm d-block mb-3">{{ date | postDate }}</span>{% endif %}
        <h1 class="section-heading"><a href="{{ page.url }}">{{ title }}</a></h1>
        {% if author %}<p class="text-muted">By {{ author }}</p>{% endif %}
        {% if venue and city %}<p class="text-muted mb-2"><span class="me-2">{% icon "map-pin" %}</span>{{ venue }} &bull; {{ city }}</p>{% endif %}
        {% if time %}<p class="text-muted mb-3"><span class="me-2">{% icon "clock" %}</span>{{ time }}</p>{% endif %}
        {% if description %}<p class="lead">{{ description }}</p>{% endif %}
        {% include "partials/content_image.njk" %}
        {% if show_tags and tags %}
        <div class="mt-3">
          {% for tag in tags | publicTags %}<a href="/tags/{{ tag | slug }}/" class="badge bg-light text-dark me-1 text-decoration-none">{{ tag }}</a>{% endfor %}
        </div>
        {% endif %}
        <hr class="my-4">
        {{ content | safe }}
      </div>
    </div>
  </div>
</section>
