<section class="section-padding border-top-custom" id="{{ about.id }}">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-4 mb-5 mb-lg-0">
        {% picture about.image, site.author.name, { class: "img-cover", sizes: "(min-width: 60rem) calc((min(100vw - 13rem, 82rem) - clamp(2rem, 8vw, 8rem) - 6rem) * 5 / 12), calc(100vw - clamp(2rem, 8vw, 8rem))" } %}
      </div>
      <div class="col-lg-7 offset-lg-1">
        <h2 class="section-heading">{{ about.title }}</h2>
        <div>{{ about.text | md | safe }}</div>
        <div class="d-flex flex-wrap gap-3 mt-4">
          {% for link in site.contact.links %}
          <a class="btn-editorial{% if not loop.first %} secondary-link{% endif %}" href="{{ 'mailto:' + site.author.email if link.email else link.url }}">{% if link.email %}{% icon "envelope" %}{% endif %}{{ link.text }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
