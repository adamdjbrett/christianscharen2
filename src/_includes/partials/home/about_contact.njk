<section class="section-padding border-top-custom" id="{{ about.id }}">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-4 mb-5 mb-lg-0">
        <picture>
          <source type="image/webp" srcset="/img/christianscharen-author-800.webp 800w, /img/christianscharen-author-1200.webp 1200w" sizes="(min-width: 60rem) 28vw, 100vw">
          <img class="img-cover" src="{{ about.image }}" alt="{{ site.author.name }}" loading="lazy" decoding="async" width="2169" height="1500">
        </picture>
      </div>
      <div class="col-lg-7 offset-lg-1">
        <p class="font-sans text-muted text-sm">{{ about.info }}</p>
        <h2 class="section-heading">{{ about.title }}</h2>
        <div>{{ about.text | md | safe }}</div>
        <p class="mt-4"><a class="btn-editorial" href="mailto:{{ speaking.email }}">Email Christian</a></p>
      </div>
    </div>
  </div>
</section>
