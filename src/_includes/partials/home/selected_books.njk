<section class="section-padding border-top-custom grey">
<div class="container">
    <div class="row mb-5">
        <div class="col-md-12 p-3">
            <h2 class="section-heading">{{site.selected_books.title}}</h2>
        </div>
        {% for group in site.selected_books.groups %}
        <div class="col-md-5 {% if loop.index0 %}offset-md-2 {% endif %}p-3">
            <h3 class="mb-4 fw-bold">{{ group.title }}</h3>
             {% for item in group.items %}
                        {% if item.url and item.url != "#" %}<a href="{{ item.url }}" class="articles-item">{% else %}<div class="articles-item">{% endif %}
                            <div class="row align-items-center">
                                <div class="col-md-12">
                                    <p>{{ item.name }}</p>
                                </div>
                            </div>
                        {% if item.url and item.url != "#" %}</a>{% else %}</div>{% endif %}
                        {% endfor %}
        </div>
        {% endfor %}
    </div>
</div>
</section>
