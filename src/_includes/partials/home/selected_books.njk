<section class="section-padding border-top-custom grey">
  <div class="container">
    <h2 class="section-heading">{{ site.selected_books.title }}</h2>
    <div class="selected-books">
      {% for group in site.selected_books.groups %}
      {# heading row + one row per pair of covers #}
      <div class="selected-books-group" style="--rows: {{ (group.items.length / 2) | round(0, 'ceil') + 1 }}">
        <h3>{{ group.title }}</h3>
        {% for item in group.items %}
        <a href="{{ item.url }}" class="selected-book">
          {% picture item.image, item.name + " book cover" %}
          <span>{{ item.name }}</span>
        </a>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
