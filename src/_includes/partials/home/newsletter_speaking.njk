<section class="border-top-custom grey">
        <div class="row g-0">
            <div class="col-lg-6 section-padding border-end" id="{{newsletter.id}}">
                <div class="px-5 mx-lg-4 reveal">
                    <span class="font-sans text-uppercase text-accent tracking-wider text-sm d-block mb-3">{{newsletter.info}}</span>
                    <h2 class="section-heading mb-4">{{newsletter.title}}</h2>
                    <p class="mb-5 fs-5 newsletter-copy">
                        {{newsletter.text}}
                    </p>                    
                    <a href="{{newsletter.button.url}}" target="_blank" rel="noopener noreferrer" class="btn-editorial mb-5">
                        {{newsletter.button.text}} <span class="ms-2 external-icon">{% icon "arrow-square-out" %}</span>
                    </a>                    
                    <div class="mt-4 newsletter-note">
                        <p class="text-muted font-serif fst-italic mb-0">
                            “{{newsletter.blockquote}}”
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 section-padding" id="{{ speaking.id }}">
                <div class="px-5 mx-lg-4 reveal" style="transition-delay: 0.2s;">
                    <span class="font-sans text-uppercase text-accent tracking-wider text-sm d-block mb-3">{{speaking.info}}</span>
                    <h2 class="section-heading mb-4">{{speaking.title}}</h2>
                    <p class="mb-4">
                        {{speaking.description}}<br/>
                        <a href="mailto:{{speaking.email}}">{{speaking.email}}</a>
                    </p>                    
                    <p class="font-serif fst-italic text-muted mb-5 pb-4 border-bottom-custom">
                        {{speaking.text}}
                    </p>
                </div>
            </div>
        </div>
</section>
