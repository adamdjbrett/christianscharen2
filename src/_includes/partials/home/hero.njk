<section class="hero" id="{{hero.id}}" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-copy">
      <p class="hero-subtitle">{{ hero.info }}</p>
      <h1 class="hero-title" id="hero-title">{{ hero.title }}</h1>
      <p class="hero-description">{{ hero.description }}</p>
      <a class="hero-scroll" href="{{ hero.button.url }}">{{ hero.button.text }} {% icon "arrow-down" %}</a>
    </div>
    <figure class="hero-portrait">
      <picture>
        <source type="image/webp" srcset="/img/christianscharen-author-800.webp 800w, /img/christianscharen-author-1200.webp 1200w, /img/christianscharen-author-1600.webp 1600w" sizes="(min-width: 60rem) 45vw, 100vw">
        <img src="{{ image }}" alt="{{ site.author.name }}" width="2169" height="1500" fetchpriority="high" decoding="async">
      </picture>
    </figure>
  </div>
</section>
