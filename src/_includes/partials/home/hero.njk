<section class="hero" id="{{hero.id}}" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-copy">
      <h1 class="hero-title" id="hero-title">{{ hero.title }}</h1>
    </div>
    <figure class="hero-portrait">
      {% picture image, site.author.name, { loading: "eager", fetchpriority: "high" } %}
    </figure>
  </div>
</section>
