<a class="image-link" href="{{ book.url or book.image }}" aria-label="{% if book.url %}View {{ book.title }} at the publisher{% else %}View full-size {{ book.title }} book cover{% endif %}">
  <img class="{{ book_image_class }}" src="/img/bookcover_tn.webp" alt="{{ book.title }} book cover"
    width="700" height="1047" loading="lazy" decoding="async">
</a>
