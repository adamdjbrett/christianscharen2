---
layout: layout.njk
title: Tags
permalink: /tags/
---

<section class="section-padding border-top-custom">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="section-heading mb-4">All Tags</h1>
                <div class="d-flex flex-wrap gap-2">
                    {% for tag in collections.tagList %}
                    <a href="/tags/{{ tag }}/" class="badge bg-light text-dark text-decoration-none p-3 fs-6">
                        {{ tag }}
                    </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>